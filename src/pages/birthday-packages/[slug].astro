---
import Layout from "../../layouts/Layout.astro";
import PackageHero from "../../components/PackageHero";
import { birthdayPackages } from "../../data/packages-data";

export function getStaticPaths() {
  return birthdayPackages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}

const { pkg } = Astro.props;
---

<Layout
  title={pkg.title}
  description={pkg.tagline}
  path={`/birthday-packages/${pkg.slug}`}
>
  <main class="flex-1">
    <PackageHero client:load pkg={pkg} categoryLabel="Birthday Packages" />
  </main>
</Layout>
